# Copy to .env and adjust.
# GPU device IDs or UUIDs (nvidia-smi -L). One 24 GB card runs everything
# (ComfyUI + editor LLM + speech-to-text); with two cards, split them.
COMFY_GPU=0
VOICE_GPU=0
# Bind address for the web UI (8800) and ComfyUI (8288). 127.0.0.1 = local only.
BIND_IP=127.0.0.1
# Editor LLM (any vLLM-servable instruct model with structured outputs)
EDITOR_MODEL=cyankiwi/Qwen3.5-4B-AWQ-4bit
# fraction of the VOICE_GPU for the editor LLM (~6 GB); 0.25 on a 24 GB card
VLLM_GPU_UTIL=0.25
CANVAS_SIZE=1024
# FLUX 3 Image Klein source: the official repo is gated (set HF_TOKEN after
# accepting it); KLEIN_REPO=ml-resources/flux-3-image-klein-comfy is an
# ungated mirror. Downloads are SHA256-checked either way.
HF_TOKEN=
KLEIN_REPO=
