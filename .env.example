# Copy to .env and adjust.
# GPU device IDs or UUIDs (nvidia-smi -L)
COMFY_GPU=0
VOICE_GPU=1
# Bind address for the web UI (8800) and ComfyUI (8288). 127.0.0.1 = local only.
BIND_IP=127.0.0.1
# Editor LLM (any vLLM-servable instruct model with structured outputs)
EDITOR_MODEL=cyankiwi/Qwen3.5-4B-AWQ-4bit
VLLM_GPU_UTIL=0.5
CANVAS_SIZE=1024
